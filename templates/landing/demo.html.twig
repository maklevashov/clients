                <div class="demo-status status-came"></div>
            </div>
        </div>
        <div id="demoMessage" class="demo-message" style="display: none;"></div>
    </div>

    <!-- Возможности -->
    <div class="demo-grid">
        <div class="demo-card">
            <div class="demo-card-header">
                <div class="demo-card-icon">📅</div>
                <h3>Умное расписание</h3>
            </div>
            <div class="demo-card-body">
                <ul class="demo-feature-list">
                    <li><span class="check">✓</span> Drag-and-drop записей</li>
                    <li><span class="check">✓</span> Цветовая индикация занятости</li>
                    <li><span class="check">✓</span> Недельный/месячный вид</li>
                    <li><span class="check">✓</span> Быстрое создание записей</li>
                </ul>
                <a href="#" class="demo-btn" onclick="showDemoFeature('расписание')">Подробнее</a>
            </div>
        </div>

        <div class="demo-card">
            <div class="demo-card-header">
                <div class="demo-card-icon">👥</div>
                <h3>Управление клиентами</h3>
            </div>
            <div class="demo-card-body">
                <ul class="demo-feature-list">
                    <li><span class="check">✓</span> Полная история записей</li>
                    <li><span class="check">✓</span> Заметки о клиентах</li>
                    <li><span class="check">✓</span> Статистика посещений</li>
                    <li><span class="check">✓</span> Быстрый поиск</li>
                </ul>
                <a href="#" class="demo-btn" onclick="showDemoFeature('клиенты')">Подробнее</a>
            </div>
        </div>

        <div class="demo-card">
            <div class="demo-card-header">
                <div class="demo-card-icon">📊</div>
                <h3>Аналитика</h3>
            </div>
            <div class="demo-card-body">
                <ul class="demo-feature-list">
                    <li><span class="check">✓</span> Доход по дням/неделям</li>
                    <li><span class="check">✓</span> Популярные услуги</li>
                    <li><span class="check">✓</span> Загруженность мастеров</li>
                    <li><span class="check">✓</span> Отчеты в Excel</li>
                </ul>
                <a href="#" class="demo-btn" onclick="showDemoFeature('аналитика')">Подробнее</a>
            </div>
        </div>
    </div>

    <!-- Преимущества -->
    <div class="advantages">
        <div class="advantage-item">
            <div class="advantage-icon">🚀</div>
            <div class="advantage-title">Быстрый старт</div>
            <div class="advantage-desc">Настройка за 5 минут</div>
        </div>
        <div class="advantage-item">
            <div class="advantage-icon">📱</div>
            <div class="advantage-title">Мобильное приложение</div>
            <div class="advantage-desc">Работайте с телефона</div>
        </div>
        <div class="advantage-item">
            <div class="advantage-icon">🔔</div>
            <div class="advantage-title">Напоминания</div>
            <div class="advantage-desc">Автоматические уведомления</div>
        </div>
        <div class="advantage-item">
            <div class="advantage-icon">💳</div>
            <div class="advantage-title">Финансовый учёт</div>
            <div class="advantage-desc">Контроль доходов</div>
        </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
        <h3>Готовы начать?</h3>
        <p>Присоединяйтесь к тысячам предпринимателей</p>
        <div class="cta-buttons">
            <a href="/register" class="cta-btn-primary">Зарегистрироваться</a>
            <a href="/login" class="cta-btn-secondary">Войти в систему</a>
        </div>
    </div>
</div>

<footer class="footer">
    <p>&copy; 2024 Запись Клиентов. Все права защищены.</p>
</footer>

<script>
    function showDemoMessage(text) {
        const messageDiv = document.getElementById('demoMessage');
        messageDiv.innerHTML = `✨ Демо-режим: ${text} ✨<br><small>В полной версии откроется карточка записи</small>`;
        messageDiv.style.display = 'block';

        setTimeout(() => {
            messageDiv.style.display = 'none';
        }, 3000);
    }

    function showDemoFeature(feature) {
        const messageDiv = document.getElementById('demoMessage');
        messageDiv.innerHTML = `🔍 Демо-режим: Подробнее о функции "${feature}"<br><small>Зарегистрируйтесь, чтобы попробовать все возможности</small>`;
        messageDiv.style.display = 'block';

        setTimeout(() => {
            messageDiv.style.display = 'none';
        }, 3000);
    }
</script>
</body>
</html>