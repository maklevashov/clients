{% extends 'base.html.twig' %}

{% block title %}{{ client.name }} - Карточка клиента{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .client-card-container {
            background: #f8f9fa;
            min-height: 100vh;
            padding-bottom: 20px;
        }

        /* Шапка */
        .client-header {
            background: white;
            padding: 20px;
            border-bottom: 1px solid #e0e0e0;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .back-btn {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: #007AFF;
            margin-bottom: 10px;
        }

        .client-name {
            font-size: 24px;
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
        }

        .client-phone {
            font-size: 16px;
            color: #666;
        }

        /* Статус-бары */
        .status-buttons {
            display: flex;
            gap: 8px;
            padding: 15px;
            background: white;
            margin: 10px;
            border-radius: 12px;
        }

        .status-btn {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 25px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .status-btn.waiting {
            background: #FFF3E0;
            color: #FF9500;
        }

        .status-btn.waiting.active {
            background: #FF9500;
            color: white;
        }

        .status-btn.came {
            background: #E8F0FE;
            color: #007AFF;
        }

        .status-btn.came.active {
            background: #007AFF;
            color: white;
        }

        .status-btn.not-came {
            background: #FFEBEE;
            color: #FF3B30;
        }

        .status-btn.not-came.active {
            background: #FF3B30;
            color: white;
        }

        .status-btn.confirmed {
            background: #E8F5E9;
            color: #34C759;
        }

        .status-btn.confirmed.active {
            background: #34C759;
            color: white;
        }

        /* Действия */
        .actions-section {
            background: white;
            margin: 10px;
            border-radius: 12px;
            padding: 15px;
        }

        .actions-title {
            font-size: 14px;
            color: #999;
            margin-bottom: 12px;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
        }

        .action-btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px;
            border: 1px solid #e0e0e0;
            border-radius: 10px;
            background: white;
            cursor: pointer;
            transition: all 0.2s;
        }

        .action-btn:hover {
            background: #f5f5f5;
        }

        .action-btn.call {
            color: #34C759;
        }

        .action-btn.message {
            color: #007AFF;
        }

        /* Статистика */
        .stats-section {
            background: white;
            margin: 10px;
            border-radius: 12px;
            padding: 15px;
            display: flex;
            justify-content: space-between;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 24px;
            font-weight: bold;
            color: #333;
        }

        .stat-label {
            font-size: 12px;
            color: #999;
        }

        /* Примечание */
        .note-section {
            background: white;
            margin: 10px;
            border-radius: 12px;
            padding: 15px;
        }

        .note-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .note-title {
            font-weight: 500;
            color: #333;
        }

        .edit-note {
            background: none;
            border: none;
            color: #007AFF;
            cursor: pointer;
        }

        .note-content {
            font-size: 14px;
            color: #666;
            line-height: 1.4;
        }

        .note-content.empty {
            color: #ccc;
        }

        /* Услуги */
        .services-section {
            background: white;
            margin: 10px;
            border-radius: 12px;
            overflow: hidden;
        }

        .services-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #f0f0f0;
        }

        .services-title {
            font-weight: 500;
            color: #333;
        }

        .add-service-btn {
            background: none;
            border: none;
            color: #007AFF;
            font-size: 20px;
            cursor: pointer;
        }

        .service-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 15px;
            border-bottom: 1px solid #f0f0f0;
        }

        .service-info {
            flex: 1;
        }

        .service-name {
            font-size: 14px;
            color: #333;
        }

        .service-price {
            font-size: 14px;
            font-weight: 500;
            color: #007AFF;
        }

        .remove-service {
            background: none;
            border: none;
            color: #ccc;
            font-size: 18px;
            cursor: pointer;
            margin-left: 10px;
        }

        /* Товары */
        .products-section {
            background: white;
            margin: 10px;
            border-radius: 12px;
            overflow: hidden;
        }

        .products-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #f0f0f0;
        }

        .products-title {
            font-weight: 500;
            color: #333;
        }

        .add-product-btn {
            background: none;
            border: none;
            color: #007AFF;
            font-size: 20px;
            cursor: pointer;
        }

        /* Итого */
        .total-section {
            background: white;
            margin: 10px;
            border-radius: 12px;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total-label {
            font-size: 16px;
            font-weight: 500;
            color: #333;
        }

        .total-price {
            font-size: 20px;
            font-weight: bold;
            color: #007AFF;
        }

        /* История посещений */
        .history-section {
            background: white;
            margin: 10px;
            border-radius: 12px;
            overflow: hidden;
        }

        .history-header {
            padding: 15px;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            justify-content: space-between;
        }

        .history-title {
            font-weight: 500;
            color: #333;
        }

        .history-item {
            padding: 15px;
            border-bottom: 1px solid #f0f0f0;
        }

        .history-date {
            font-size: 14px;
            font-weight: 500;
            color: #FF9500;
            margin-bottom: 5px;
        }

        .history-time {
            font-size: 13px;
            color: #666;
        }

        .history-master {
            font-size: 13px;
            color: #666;
            margin-top: 3px;
        }

        .history-comment {
            font-size: 12px;
            color: #999;
            margin-top: 5px;
            font-style: italic;
        }

        .no-history {
            padding: 30px;
            text-align: center;
            color: #999;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="client-card-container">
        <div class="client-header">
            <button class="back-btn" onclick="history.back()">←</button>
            <div class="client-name">{{ client.name }}</div>
            <div class="client-phone">{{ client.phone }}</div>
        </div>

        <!-- Статусы -->
        <div class="status-buttons">
            <button class="status-btn waiting {{ appointment.status == 'waiting' ? 'active' : '' }}"
                    onclick="updateStatus('waiting')">Ожидание</button>
            <button class="status-btn confirmed {{ appointment.status == 'confirmed' ? 'active' : '' }}"
                    onclick="updateStatus('confirmed')">Подтвердил</button>
            <button class="status-btn came {{ appointment.status == 'came' ? 'active' : '' }}"
                    onclick="updateStatus('came')">Пришёл</button>
            <button class="status-btn not-came {{ appointment.status == 'not_came' ? 'active' : '' }}"
                    onclick="updateStatus('not_came')">Не пришёл</button>
        </div>

        <!-- Действия -->
        <div class="actions-section">
            <div class="actions-title">Действия</div>
            <div class="action-buttons">
                <button class="action-btn call" onclick="makeCall()">
                    <span>📞</span> Позвонить
                </button>
                <button class="action-btn message" onclick="sendMessage()">
                    <span>💬</span> Написать
                </button>
            </div>
        </div>

        <!-- Статистика -->
        <div class="stats-section">
            <div class="stat-item">
                <div class="stat-value">{{ totalVisits }}</div>
                <div class="stat-label">Визитов</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">{{ noShows }}</div>
                <div class="stat-label">Неявок</div>
            </div>
        </div>

        <!-- Примечание -->
        <div class="note-section">
            <div class="note-header">
                <div class="note-title">Примечание о клиенте</div>
                <button class="edit-note" onclick="editNote()">✎</button>
            </div>
            <div class="note-content {{ appointment.comment ? '' : 'empty' }}" id="noteContent">
                {{ appointment.comment ?: 'Добавить примечание' }}
            </div>
        </div>

        <!-- Услуги -->
        <div class="services-section">
            <div class="services-header">
                <div class="services-title">Услуги</div>
                <button class="add-service-btn" onclick="addService()">+</button>
            </div>
            <div id="servicesList">
                {% for service in appointment.services %}
                    <div class="service-item" data-index="{{ loop.index0 }}">
                        <div class="service-info">
                            <div class="service-name">{{ service.name }}</div>
                        </div>
                        <div class="service-price">{{ service.price }} ₽</div>
                        <button class="remove-service" onclick="removeService({{ loop.index0 }})">✕</button>
                    </div>
                {% else %}
                    <div class="service-item" style="justify-content: center; color: #ccc;">
                        Нет услуг
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Товары -->
        <div class="products-section">
            <div class="products-header">
                <div class="products-title">Товары и абонементы</div>
                <button class="add-product-btn" onclick="addProduct()">+</button>
            </div>
            <div id="productsList">
                {% for product in appointment.products %}
                    <div class="service-item" data-index="{{ loop.index0 }}">
                        <div class="service-info">
                            <div class="service-name">{{ product.name }} x{{ product.quantity }}</div>
                        </div>
                        <div class="service-price">{{ product.price * product.quantity }} ₽</div>
                        <button class="remove-service" onclick="removeProduct({{ loop.index0 }})">✕</button>
                    </div>
                {% else %}
                    <div class="service-item" style="justify-content: center; color: #ccc;">
                        Нет товаров
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Итого -->
        <div class="total-section">
            <div class="total-label">К оплате</div>
            <div class="total-price" id="totalPrice">{{ appointment.totalPrice|default(0) }} ₽</div>
        </div>

        <!-- История посещений -->
        <div class="history-section">
            <div class="history-header">
                <div class="history-title">История посещений</div>
            </div>
            <div id="historyList">
                {% for visit in history %}
                    <div class="history-item">
                        <div class="history-date">{{ visit.date }}</div>
                        <div class="history-time">{{ visit.startTime }} - {{ visit.endTime }}</div>
                        <div class="history-master">{{ visit.masterName }}</div>
                        {% if visit.comment %}
                            <div class="history-comment">Комментарий: {{ visit.comment }}</div>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="no-history">Нет истории посещений</div>
                {% endfor %}
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let currentAppointmentId = {{ appointment.id }};
        let currentClientId = {{ client.id }};

        function updateStatus(status) {
            $.ajax({
                url: `/api/appointments/${currentAppointmentId}/status`,
                method: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ status: status }),
                success: function() {
                    location.reload();
                }
            });
        }

        function makeCall() {
            const phone = '{{ client.phone }}';
            window.location.href = `tel:${phone}`;
        }

        function sendMessage() {
            const phone = '{{ client.phone }}';
            window.location.href = `sms:${phone}`;
        }

        function editNote() {
            const currentNote = $('#noteContent').text();
            const newNote = prompt('Введите примечание:', currentNote === 'Добавить примечание' ? '' : currentNote);

            if (newNote !== null) {
                $.ajax({
                    url: `/api/appointments/${currentAppointmentId}/note`,
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ comment: newNote }),
                    success: function() {
                        location.reload();
                    }
                });
            }
        }

        function addService() {
            const name = prompt('Введите название услуги:');
            if (!name) return;

            const price = prompt('Введите стоимость услуги:');
            if (!price) return;

            $.ajax({
                url: `/api/appointments/${currentAppointmentId}/services`,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ name: name, price: parseFloat(price) }),
                success: function() {
                    location.reload();
                }
            });
        }

        function removeService(index) {
            if (confirm('Удалить услугу?')) {
                $.ajax({
                    url: `/api/appointments/${currentAppointmentId}/services/${index}`,
                    method: 'DELETE',
                    success: function() {
                        location.reload();
                    }
                });
            }
        }

        function addProduct() {
            const name = prompt('Введите название товара:');
            if (!name) return;

            const price = prompt('Введите стоимость товара:');
            if (!price) return;

            const quantity = prompt('Введите количество:', '1');
            if (!quantity) return;

            $.ajax({
                url: `/api/appointments/${currentAppointmentId}/products`,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    name: name,
                    price: parseFloat(price),
                    quantity: parseInt(quantity)
                }),
                success: function() {
                    location.reload();
                }
            });
        }

        function removeProduct(index) {
            if (confirm('Удалить товар?')) {
                $.ajax({
                    url: `/api/appointments/${currentAppointmentId}/products/${index}`,
                    method: 'DELETE',
                    success: function() {
                        location.reload();
                    }
                });
            }
        }
    </script>
{% endblock %}